{
  "name": "jesus-olivares-cv",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm assets && next dev",
    "assets": "tsx scripts/build-cv.tsx && tsx scripts/optimize-images.ts",
    "prebuild": "pnpm assets",
    "build": "next build",
    "start": "serve out -l 3000",
    "cv": "tsx scripts/build-cv.tsx",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "playwright test",
    "screenshots": "playwright test tests/screenshots.spec.ts",
    "test": "playwright test"
  },
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-dialog": "1.3.1",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.65.0",
    "@react-pdf/renderer": "4.9.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "pdfjs-dist": "^6.5.438",
    "serve": "^14.2.7",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "^5.9.3"
  }
}
